-- (1) Minimal location

trait Actor
trait Locatable
trait Location

relation At(subject: Locatable, location: Location) unique(subject)
relation Path(from: Location, to: Location)

action Go(actor: (Actor & Locatable) { At(actor, ?here) }, target: Location) {
  when (Path(here, target)) {
    set At(actor, target)
  }
}

query GetExits(actor: Actor) {
  At(actor, ?here) & Path(here, ?target)
}

entity Player { Actor, Locatable }

namespace ActOne {
  entity Cell { Location }
  entity Corridor { Location }
  entity Outside { Location }
  set {
    Path(Cell, Corridor);
    Path(Corridor, Cell);
    Path(Corridor, Outside);
    Path(Outside, Corridor);
    At(Player, Cell);
  }
}

-- (2) Extend with descriptions

trait Describable

predicate IsColocated(actor: (Actor & Locatable) { At(actor, ?here) }, target: Locatable) {
  when (At(target, here)) {
    succeed;
  }
}

-- Note that the command succeeds without output. This is because the nature
-- of the description (images, text, etc) is a simulation concern. This
-- merely tracks what it is possible to examine.
action Examine(actor: Actor, target) {
  when (At(actor, target) | IsColocated(actor, target)) {
    succeed;
  }
}

namespace ActOne {
  entity Bars { Describable, Locatable }
  set {
    At(Bars, Cell);
  }
}


-- (3) Extend with portable items

trait Portable

relation Carrying(Actor, item: Portable) unique(item)

query GetInventory(actor: Actor) {
  Carrying(actor, ?item)
}

action Take(actor: Actor, target: Portable) {
  when (IsColocated(actor, target)) {
    set Carrying(actor, target)
  }
}

-- Note: this will not run if the target is Portable but
-- not also Locatable.
after Take(_, target: Locatable { At(target, ?here) }) {
  set {
    !At(target, here);
  }
}

action Drop(actor: Actor, target: Portable) {
  when (Carrying(actor, target)) {
    set {
      !Carrying(actor, target);
    }
  }
}

after Drop(actor: Locatable { At(actor, ?here) }, target: Locatable) {
  set {
    At(target, here);
  }
}

namespace ActOne {
  entity BoneShard { Portable, Describable, Locatable }
  set {
      At(BoneShard, Cell);
  }
}

-- (4) Extend with doors

trait Openable

relation Opened(Openable)

-- Note: a Gated relation may describe a Path that does not exist (or
-- which once existed). It remains legal but will never match unless
-- the referenced relation is explicitly (re)declared.
relation Gated(path: Path, door: Openable) unique(path)

-- Note: before rules run before the referenced action is considered.
-- before rules that do not return explict failure or success defer
-- to the next relevant rule.
before Go(
  actor: (Actor & Locatable) { At(actor, ?here) },
  target: Location { Gated(Path(here, target), ?door) }
) {
  when (!Opened(door)) {
    fail;
  }
}

-- Note that "before rules" may also preempt or defer to predicates
-- provided that they do not mutate state.
before IsColocated(
  actor: (Actor & Locatable) { At(actor, ?here) },
  target: Locatable
) {
  when (Gated(Path(here, _), ?door) & target == door) {
    succeed;
  }
}

action Open(actor: Actor, door: Openable) {
  when (IsColocated(actor, door) & !Opened(door)) {
    set Opened(door)
  }
}

action Close(actor: Actor, door: Openable) {
  when (IsColocated(actor, door) & Opened(door)) {
    set !Opened(door)
  }
}

namespace ActOne {
  extend Bars { Openable }
  set {
    !At(Bars, Cell);
    Gated(Path(Cell, Corridor), Bars);
    Gated(Path(Corridor, Cell), Bars);
  }
}

-- (5) Extend doors to be lockable.

trait Key
trait Lockable

relation Locked(Lockable)
relation LockedWith(Lockable, Key)

predicate IsReachable(actor: Actor, target) {
  when (IsColocated(actor, target) | Carrying(actor, target)) {
    succeed;
  }
}

replace action Open(actor: Actor, door: Openable) {
  when (IsReachable(actor, door) & !Opened(door) & !Locked(door)) {
    set Opened(door)
  }
}

action Unlock(actor: Actor, door: Lockable, key: Key) {
  when (IsReachable(actor, key) & IsReachable(actor, door) & Locked(door) & LockedWith(door, key)) {
    set !Locked(door)
  }
}

action Lock(actor: Actor, door: Lockable, key: Key) {
  when (IsReachable(actor, key) & IsReachable(actor, door) & !Locked(door) & LockedWith(door, key)) {
    set Locked(door)
  }
}

extend Bars { Lockable }
entity MasterKey { Key, Portable, Locatable }
entity MakeshiftKey { Key, Portable, Locatable }
set {
  Locked(Bars);
  LockedWith(Bars, MasterKey);
  At(MasterKey, Cell);
}

-- (6) Visibility

-- Ie, anything not explicitly transparent is opaque by default.
relation Transparent(Any)
relation ConveysVisibility(Path)

predicate IsVisibleTo(actor: Actor, target) {
  when (At(actor, target) | IsColocated(actor, target) | Carrying(actor, target)) {
    succeed;
  }
}

predicate DoesBlockVisibility(door: Openable) {
  when (!Transparent(door) & !Opened(door)) {
    succeed;
  }
}

before IsVisibleTo(
  actor: Actor { At(actor, ?here) },
  target: Locatable { At(target, ?location) & Path(here, location) }
) {
  when (
    ConveysVisibility(Path(here, location)) &
    !(Gated(Path(here, location), ?door) & DoesBlockVisibility(door))
  ) {
    succeed;
  }
}

-- The player can now see through open or non-opaque closed doors.
replace action Examine(actor: Actor, target) {
  when (IsVisibleTo(actor, target)) {
    succeed;
  }
}

query GetVisibles(actor: Actor) {
  At(actor, ?target)
  | (At(actor, ?here) & At(?target, here))
  | Carrying(actor, ?target)
  | (At(actor, ?here) & Gated(Path(here, _), ?target))
  | (At(actor, ?here) & At(?target, ?location) & Path(here, location)
     & ConveysVisibility(Path(here, location))
     & !(Gated(Path(here, location), ?door) & !Transparent(door) & !Opened(door)))
}

entity Guard { Actor, Locatable, Describable }
entity Closet { Location, Describable }
entity ClosetDoor { Openable, Locatable, Describable }
entity Mop { Portable, Describable, Locatable }

set {
  ConveysVisibility(Path(Cell, Corridor));
  ConveysVisibility(Path(Corridor, Cell));
  ConveysVisibility(Path(Corridor, Closet));
  ConveysVisibility(Path(Closet, Corridor));
  Transparent(Bars);
  Path(Corridor, Closet);
  Path(Closet, Corridor);
  Gated(Path(Corridor, Closet), ClosetDoor);
  Gated(Path(Closet, Corridor), ClosetDoor);
  At(Guard, Corridor);
  At(Mop, Closet);
}

-- (7) Simple conversation.
-- Introduces: actions with multiple typed arguments. Conversation reach is
-- decided by IsVisibleTo (section 6) — no separate before-rule needed; the
-- Guard in the Corridor is reachable from the Cell because the Bars are
-- transparent and the Cell↔Corridor path conveys visibility.

trait Speaker
trait Topic

relation TalksAbout(Speaker, Topic)

action TalkAbout(actor: Actor, speaker: Speaker, topic: Topic) {
  when (IsVisibleTo(actor, speaker) & TalksAbout(speaker, topic)) {
    succeed;
  }
}

extend Guard { Speaker }
entity Bribery { Topic }
entity Checkers { Topic }

set {
  TalksAbout(Guard, Bribery);
}

-- (8) Extend to conversation trees.
-- Introduces: an explicit unique(actor, speaker) state relation
-- (InConversation) tracking the current conversation topic per (Actor,
-- Speaker), a `LeadsTo` adjacency over topics, and a predicate WillTalkAbout
-- that holds when the actor can reach the topic either as a top-level entry
-- (TalksAbout) or as a sub-topic of the current conversation (InConversation
-- + LeadsTo). The (7) TalkAbout action is replaced to consult WillTalkAbout,
-- and a single after-rule advances InConversation uniformly on every
-- successful talk.

relation InConversation(actor: Actor, speaker: Speaker, topic: Topic) unique(actor, speaker)
relation LeadsTo(Speaker, Topic, Topic)

-- Per-conversation history: TopicHistory(actor, speaker, current, prev) means
-- the player got to `current` from `prev`. SwitchTopics walks one step back
-- by looking up the entry keyed on the current topic.
relation TopicHistory(actor: Actor, speaker: Speaker, current: Topic, prev: Topic) unique(actor, speaker, current)

entity Whatever { Topic }
entity Weather { Topic }
entity OfferMoney { Topic }
entity OfferAFavor { Topic }
entity BriberyIsWrong { Topic }

-- TalkTo enters a conversation with the speaker. The conversation always
-- opens on the "Whatever" small-talk topic; navigable sub-topics then come
-- from LeadsTo(speaker, Whatever, …).
action TalkTo(actor: Actor, speaker: Speaker) {
  when (IsVisibleTo(actor, speaker) & TalksAbout(speaker, Whatever)) {
    succeed;
  }
}

after TalkTo(actor: Actor, speaker: Speaker) {
  set InConversation(actor, speaker, Whatever);
}

-- TalkAbout navigates from the current topic to one of its LeadsTo children.
-- It is no longer an entry point; players must TalkTo first.
predicate WillTalkAbout(actor: Actor, speaker: Speaker, subTopic: Topic) {
  when (InConversation(actor, speaker, ?topic) & LeadsTo(speaker, topic, subTopic)) {
    succeed;
  }
}

replace action TalkAbout(actor: Actor, speaker: Speaker, topic: Topic) {
  when (IsVisibleTo(actor, speaker) & WillTalkAbout(actor, speaker, topic)) {
    succeed;
  }
}

-- Record the back-pointer before InConversation is displaced, then advance.
after TalkAbout(actor: Actor, speaker: Speaker, topic: Topic) {
  when (InConversation(actor, speaker, ?current)) {
    set TopicHistory(actor, speaker, topic, current);
  }
  set InConversation(actor, speaker, topic);
}

-- SwitchTopics backs up one step along the history chain. Fails at the root
-- of the conversation tree, which is where the UI flips to "Leave".
action SwitchTopics(actor: Actor, speaker: Speaker) {
  when (InConversation(actor, speaker, ?current) & TopicHistory(actor, speaker, current, ?prev)) {
    set !TopicHistory(actor, speaker, current, prev);
    set InConversation(actor, speaker, prev);
  }
}

action StopTalking(actor: Actor, speaker: Speaker) {
  when (InConversation(actor, speaker, ?topic)) {
    set !InConversation(actor, speaker, topic);
  }
}

-- Topics enumerates the navigable children of the current topic. The conversation
-- menu reads this; results outside the menu loop are unused.
query Topics(actor: Actor, speaker: Speaker) {
  InConversation(actor, speaker, ?current) & LeadsTo(speaker, current, ?topic)
}

-- Current conversation header — used to render "Talking about <topic>".
query CurrentTopic(actor: Actor, speaker: Speaker) {
  InConversation(actor, speaker, ?topic)
}

-- The menu probes this to decide whether the back option is "change topics"
-- (history exists) or "leave" (we're at the root).
query PreviousTopic(actor: Actor, speaker: Speaker) {
  InConversation(actor, speaker, ?current) & TopicHistory(actor, speaker, current, ?prev)
}

set {
  !TalksAbout(Guard, Bribery);
  TalksAbout(Guard, Whatever);
  LeadsTo(Guard, Whatever, Bribery);
  LeadsTo(Guard, Whatever, Weather);
  LeadsTo(Guard, Bribery, OfferMoney);
  LeadsTo(Guard, Bribery, OfferAFavor);
  LeadsTo(Guard, Bribery, BriberyIsWrong);
}

-- (9) Reactions to conversation.
-- Introduces: entity-literal sugar for parameter slots (`Guard`,
-- `OfferMoney`) and after-rules that either preempt the action by failing or
-- commit consequences. Because actions are atomic, a failing after-rule rolls
-- back the TalkAbout action and any earlier after-rule effects.

entity Money { Portable, Locatable }

-- Offering money requires the actor to actually have some.
after TalkAbout(actor: Actor, Guard, OfferMoney) {
  when (!Carrying(actor, Money)) {
    fail;
  }
}

-- Offering a favor moves the master key from the guard to the actor.
after TalkAbout(actor: Actor, Guard, OfferAFavor) {
  set {
    !Carrying(Guard, MasterKey);
    Carrying(actor, MasterKey);
  }
  emit GuardHandsOver(actor, MasterKey);
}

set {
  -- The guard now starts carrying the master key; the player must walk
  -- Whatever → Bribery → OfferAFavor to get it. Money is never placed in
  -- the world, so offering it fails.
  !At(MasterKey, Cell);
  Carrying(Guard, MasterKey);
}

-- (10) Regression validations.
-- Introduces: first-class validation declarations. These assertions are meant
-- to be run before committing authored mutations so that core story guarantees
-- remain intact.

validation TutorialSmoke {
  assert fact At(Player, Cell);
  assert not fact At(Player, Outside);
  assert query Locked(Bars);
  assert play Go(Player, Outside) => failed;
}

-- (11) Playable mockup.
-- Introduces: mockup menus. Play mode starts at the declared mockup start call.
-- intentionally raw: titles, details, option labels, successes, and failures
-- come straight from ids and relation/action results so coauthoring agents can
-- maintain it without also maintaining prose.

mockup start { MainMenu(Player) }

mockup MainMenu(cursor: Actor { At(cursor, ?here) }) {
  title { here }
  detail {
    "visible here: " GetVisibles(cursor)
    "exits: " GetExits(cursor)
  }
  options {
    "go" -> GoMenu(cursor)
    "take" -> TakeMenu(cursor)
    "drop" -> DropMenu(cursor)
    "inventory" -> InventoryMenu(cursor)
    "examine" -> ExamineMenu(cursor)
    "open" -> OpenMenu(cursor)
    "close" -> CloseMenu(cursor)
    "unlock" -> UnlockMenu(cursor)
    "lock" -> LockMenu(cursor)
    "talk" -> TalkToMenu(cursor)
  }
}

mockup InventoryMenu(cursor: Actor) {
  title { "Inventory" }
  detail {
    "carrying: " GetInventory(cursor)
  }
  options {
    item: GetInventory(cursor) -> Examine(cursor, item)
    "back" -> MainMenu(cursor)
  }
}

mockup GoMenu(cursor: Actor { At(cursor, ?here) }) {
  title { "Go..." }
  options {
    there: Path(here, there) -> Go(cursor, there)
    "never mind" -> MainMenu(cursor)
  }
}

mockup TakeMenu(cursor: Actor) {
  title { "Take..." }
  options {
    item: GetVisibles(cursor) -> Take(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup DropMenu(cursor: Actor) {
  title { "Drop..." }
  options {
    item: Carrying(cursor, item) -> Drop(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup ExamineMenu(cursor: Actor) {
  title { "Examine..." }
  options {
    item: GetVisibles(cursor) -> Examine(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup OpenMenu(cursor: Actor) {
  title { "Open..." }
  options {
    item: GetVisibles(cursor) -> Open(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup CloseMenu(cursor: Actor) {
  title { "Close..." }
  options {
    item: GetVisibles(cursor) -> Close(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup UnlockMenu(cursor: Actor) {
  title { "Unlock..." }
  options {
    item: GetVisibles(cursor) -> UnlockWithMenu(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup UnlockWithMenu(cursor: Actor, item) {
  title { "Unlock" item "with..." }
  options {
    key: Carrying(cursor, key) -> Unlock(cursor, item, key)
    "never mind" -> MainMenu(cursor)
  }
}

mockup LockMenu(cursor: Actor) {
  title { "Lock..." }
  options {
    item: GetVisibles(cursor) -> LockWithMenu(cursor, item)
    "never mind" -> MainMenu(cursor)
  }
}

mockup LockWithMenu(cursor: Actor, item) {
  title { "Lock" item "with..." }
  options {
    key: Carrying(cursor, key) -> Lock(cursor, item, key)
    "never mind" -> MainMenu(cursor)
  }
}

mockup TalkToMenu(cursor: Actor) {
  title { "Talk to..." }
  options {
    speaker: GetVisibles(cursor) -> TalkTo(cursor, speaker) -> TalkMenu(cursor, speaker)
    "never mind" -> MainMenu(cursor)
  }
}

mockup TalkMenu(cursor: Actor, speaker: Speaker) {
  title { "Talking to" speaker }
  detail {
    "current topic: " CurrentTopic(cursor, speaker)
  }
  options {
    topic: Topics(cursor, speaker) -> TalkAbout(cursor, speaker, topic) -> TalkMenu(cursor, speaker)
    when (!InConversation(cursor, speaker, Whatever)) {
      "change topics" -> SwitchTopics(cursor, speaker) -> TalkMenu(cursor, speaker)
    }
    when (InConversation(cursor, speaker, Whatever)) {
      "leave" -> StopTalking(cursor, speaker) -> MainMenu(cursor)
    }
  }
}
