# Coauthor mode configuration. Copy to .env and fill in.

# Provider selection. One of: anthropic, openai
QUALMS_AGENT_PROVIDER=anthropic

# Model id for the selected provider.
#   anthropic: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
#   openai:    gpt-4.1, gpt-4.1-mini, gpt-5, etc.
QUALMS_AGENT_MODEL=claude-sonnet-4-6

# API keys (set only the one matching your provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional tuning
QUALMS_AGENT_TEMPERATURE=0.2
QUALMS_AGENT_MAX_STEPS=16
